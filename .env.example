# ─────────────────────────────────────────────────────────────────────────────
#  Nudge — copy this to .env and fill it in. Nothing here is per-person:
#  every user's targets, times, timezone and tone live in their own account.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The AI brain. Free key from https://console.groq.com/keys
# Leave blank to use a local Ollama instead (offline development only).
GROQ_API_KEY=

# Your Telegram bot, from @BotFather on Telegram. Free, no card, no limits.
#   1. Message @BotFather, send /newbot, follow the prompts
#   2. It gives you a token like 8123456789:AAF...  -> TELEGRAM_BOT_TOKEN
#   3. The @name you chose (without the @)          -> TELEGRAM_BOT_USERNAME
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# A random string you invent. Telegram doesn't sign its webhooks, so this secret
# is what proves an incoming update really came from Telegram. It goes in the
# webhook URL AND in a header, and both are checked.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=

# Signs the session cookies. Generate the same way as above. Changing it signs
# everyone out; leaving it at a guessable value lets anyone forge a session.
SECRET_KEY=

# The public https URL this app is reachable at. The Telegram webhook is
# registered against it on every boot, so it must be right or nothing arrives.
# On Render this is filled in automatically as RENDER_EXTERNAL_URL.
PUBLIC_URL=

# ── SIGN-UPS ────────────────────────────────────────────────────────────────
# One shared free Groq key serves every user here, so the number of active
# accounts is what decides whether replies feel instant or rate-limited.
# Comma-separated codes; each works INVITE_USES times.
INVITE_CODES=first-ten
INVITE_USES=5
MAX_USERS=25

# ── CLOUD SNAPSHOT (strongly recommended) ───────────────────────────────────
# A free host wipes its disk on every deploy. The whole SQLite file is
# snapshotted here every few minutes and pulled back on a cold boot; without
# it, one deploy erases everybody's history. Free tier: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_BACKUP_MINUTES=10

# ── OPTIONAL ────────────────────────────────────────────────────────────────
APP_NAME=Nudge
# Pre-selected in the onboarding form; every user then picks their own.
DEFAULT_TIMEZONE=UTC
DEFAULT_STEP_GOAL=8000
DEFAULT_WATER_GOAL_ML=2500

# Models. Groq retires models without notice — if one disappears the app falls
# back to a current one on its own, but these let you pin a choice.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_ROUTER_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_FALLBACK=whisper-large-v3-turbo

# Local models, used only when GROQ_API_KEY is blank.
OLLAMA_MODEL=llama3.2:3b
VISION_MODEL=qwen2.5vl:7b

# Tuning you will probably never touch.
SESSION_DAYS=30
CORRECTION_WINDOW_MIN=30
MIN_REMINDER_GAP_MIN=4
PHOTO_SETTLE_SEC=8
